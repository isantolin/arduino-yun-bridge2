{
  "mcpServers": {
    "github": {
      "command": "podman",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ]
    },
    "semgrep": {
      "command": "/home/ignaciosantolin/.local/bin/semgrep",
      "args": ["mcp"]
    },
    "serial-mcp-server": {
      "command": "/home/ignaciosantolin/.local/bin/serial-mcp-server",
      "args": ["serve"]
    }
  }
}
