# [SIL-2] Static limits for Zero-Heap operation
rpc.pb.RpcEnvelope.encrypted_payload_with_tag max_size:80
rpc.pb.RpcEnvelope.nonce                      max_size:12
rpc.pb.RpcEnvelope.daemon_metrics             type:FT_IGNORE
rpc.pb.ConsoleWrite.data                      max_size:64
rpc.pb.DatastorePut.key                       max_size:32
rpc.pb.DatastorePut.value                     max_size:64
rpc.pb.DatastoreGet.key                       max_size:32
rpc.pb.DatastoreGetResponse.value             max_size:64
rpc.pb.MailboxPush.data                       max_size:64
rpc.pb.MailboxReadResponse.content            max_size:64
rpc.pb.FileWrite.path                         max_size:64
rpc.pb.FileWrite.data                         max_size:64
rpc.pb.FileRead.path                          max_size:64
rpc.pb.FileRemove.path                        max_size:64
rpc.pb.FileReadResponse.content               max_size:64
rpc.pb.ProcessRunAsync.command                max_size:60
rpc.pb.ProcessPollResponse.stdout_data        max_size:32
rpc.pb.ProcessPollResponse.stderr_data        max_size:32
rpc.pb.LinkSync.nonce                         max_size:16
rpc.pb.LinkSync.tag                           max_size:16
rpc.pb.SpiTransfer.data                       max_size:64
rpc.pb.SpiTransferResponse.data               max_size:64
rpc.pb.GenericResponse.status                 max_size:8
rpc.pb.GenericResponse.message                max_size:48
rpc.pb.Capabilities.board_name                max_size:16

# Default: skip all non-MCU messages
* skip_message:true

# MCU Messages
rpc.pb.RpcEnvelope              skip_message:false
rpc.pb.VersionResponse          skip_message:false
rpc.pb.FreeMemoryResponse       skip_message:false
rpc.pb.Capabilities             skip_message:false
rpc.pb.PinMode                  skip_message:false
rpc.pb.DigitalWrite             skip_message:false
rpc.pb.AnalogWrite              skip_message:false
rpc.pb.PinRead                  skip_message:false
rpc.pb.ClockSyncRequest         skip_message:false
rpc.pb.ClockSyncResponse        skip_message:false
rpc.pb.PinSubscribeRequest      skip_message:false
rpc.pb.PinSubscribeResponse     skip_message:false
rpc.pb.PinUpdateEvent           skip_message:false
rpc.pb.DigitalReadResponse      skip_message:false
rpc.pb.AnalogReadResponse       skip_message:false
rpc.pb.ConsoleWrite             skip_message:false
rpc.pb.DatastorePut             skip_message:false
rpc.pb.DatastoreGet             skip_message:false
rpc.pb.DatastoreGetResponse     skip_message:false
rpc.pb.MailboxPush              skip_message:false
rpc.pb.MailboxProcessed         skip_message:false
rpc.pb.MailboxAvailableResponse skip_message:false
rpc.pb.MailboxReadResponse      skip_message:false
rpc.pb.FileWrite                skip_message:false
rpc.pb.FileRead                 skip_message:false
rpc.pb.FileRemove               skip_message:false
rpc.pb.FileReadResponse         skip_message:false
rpc.pb.ProcessRunAsync          skip_message:false
rpc.pb.ProcessRunAsyncResponse  skip_message:false
rpc.pb.ProcessPoll              skip_message:false
rpc.pb.ProcessPollResponse      skip_message:false
rpc.pb.ProcessKill              skip_message:false
rpc.pb.GenericResponse          skip_message:false
rpc.pb.AckPacket                skip_message:false
rpc.pb.HandshakeConfig          skip_message:false
rpc.pb.SetBaudratePacket        skip_message:false
rpc.pb.LinkSync                 skip_message:false
rpc.pb.EnterBootloader          skip_message:false
rpc.pb.SpiTransfer              skip_message:false
rpc.pb.SpiTransferResponse      skip_message:false
rpc.pb.SpiConfig                skip_message:false

# Exclude extension definitions from Nanopb C generation
rpc.pb.constants               type:FT_IGNORE
rpc.pb.hardware                type:FT_IGNORE
rpc.pb.handshake               type:FT_IGNORE
rpc.pb.status_reasons          type:FT_IGNORE
rpc.pb.topics                  type:FT_IGNORE
rpc.pb.actions                 type:FT_IGNORE
rpc.pb.architectures           type:FT_IGNORE
rpc.pb.capabilities            type:FT_IGNORE
rpc.pb.cmd_opts                type:FT_IGNORE
rpc.pb.status_opts             type:FT_IGNORE
rpc.pb.cloud_defaults          type:FT_IGNORE
rpc.pb.cloud_suffixes          type:FT_IGNORE
rpc.pb.msg_cloud_topic         type:FT_IGNORE
rpc.pb.enum_cloud_topic        type:FT_IGNORE
rpc.pb.msg_error_init          type:FT_IGNORE
