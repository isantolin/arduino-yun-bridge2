# ==============================================================================
# Semgrep Ignore Patterns (.semgrepignore)
# Excludes build artifacts, intermediate directories, and autogenerated files.
# Explicitly DOES NOT ignore tests/ so test suites are audited.
# ==============================================================================

# Git and temporary build directories
.git/
.tox/
.tmp_tests/
.hypothesis/
typings/
openwrt-sdk/
build/
dist/
bin/
rpmbuild/
mcubridge-gateway/rpmbuild/
node_modules/

# Python caching and packaging artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.whl
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
*.zip
*.log

# Coverage reports
.coverage
coverage/
coverage.xml
*.gcda
*.gcno

# Native objects and binaries
*.o
*.so
*.ipk
*.apk

# Autogenerated protocol and RPC stubs
*_pb2.py
*_pb2.pyi
*_grpc.py
mcubridge.pb.c
mcubridge.pb.h
validate.pb.c
validate.pb.h
validate_pb2.py
validate_pb2.pyi
tools/protocol/buf/
