# Environment overrides for mcubridge-gateway.service.
# Copy to /etc/mcubridge-gateway/env with permissions 0640 (root:mcubridge).
# All variables map 1:1 to CLI flags parsed by mcubridge-gateway-cpp/src/gateway_main.cc.

# Required TLS 1.3 server certificate chain and private key (PEM).
# Keep the private key mode 0600 owned by mcubridge (or 0640 root:mcubridge).
MCUBRIDGE_GATEWAY_CERT=/etc/mcubridge-gateway/gateway.crt
MCUBRIDGE_GATEWAY_KEY=/etc/mcubridge-gateway/gateway.key

# Required CA certificate bundle used to verify device/client SPIFFE URI SAN certs.
MCUBRIDGE_GATEWAY_CLIENT_CA=/etc/mcubridge-gateway/clients-ca.crt

# Optional deny-by-default client ACL file (ADR-0007).
# Leave empty (MCUBRIDGE_GATEWAY_ACL=) to start with an empty deny-all ACL.
MCUBRIDGE_GATEWAY_ACL=/etc/mcubridge-gateway/gateway.acl

# Private staging root owned by mcubridge (mode 0700, non-symlink).
MCUBRIDGE_GATEWAY_STAGING_DIR=/var/lib/mcubridge-gateway

# Listen address ("*" binds all interfaces via getaddrinfo AI_PASSIVE) and TCP port.
# Ports < 1024 require a systemd drop-in granting CAP_NET_BIND_SERVICE.
MCUBRIDGE_GATEWAY_BIND=*
MCUBRIDGE_GATEWAY_PORT=8443
