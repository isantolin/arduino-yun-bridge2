{
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestPath": "pytest",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "."
  ],
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/mcubridge-library-arduino/src",
    "${workspaceFolder}/mcubridge-library-arduino/tests",
    "${workspaceFolder}/tools/arduino_stub/include",
    "${workspaceFolder}/.dummy_libs/Embedded_Template_Library/include",
    "${workspaceFolder}/.dummy_libs/Embedded_Template_Library/arduino",
    "${workspaceFolder}/.dummy_libs/wolfSSL",
    "${workspaceFolder}/.dummy_libs/PacketSerial/src",
    "${workspaceFolder}/.dummy_libs/Unity/src",
    "~/Arduino/libraries/**"
  ],
  "C_Cpp.default.defines": [
    "ARDUINO=100",
    "BRIDGE_HOST_TEST=1",
    "WOLFSSL_USER_SETTINGS",
    "ETL_NO_STL",
    "BRIDGE_ENABLE_CONSOLE=1",
    "BRIDGE_ENABLE_DATASTORE=1",
    "BRIDGE_ENABLE_MAILBOX=1",
    "BRIDGE_ENABLE_FILESYSTEM=1",
    "BRIDGE_ENABLE_PROCESS=1",
    "BRIDGE_ENABLE_SPI=1",
    "BRIDGE_ENABLE_TEST_INTERFACE=1",
    "BRIDGE_FAULT_INJECTION=1"
  ],
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "makefile.configurations": [
    {
      "name": "mcubridge",
      "makefilePath": "${workspaceFolder}/mcubridge/Makefile",
      "makeDirectory": "${workspaceFolder}/mcubridge"
    },
    {
      "name": "mcubridge-gateway",
      "makefilePath": "${workspaceFolder}/mcubridge-gateway/Makefile",
      "makeDirectory": "${workspaceFolder}/mcubridge-gateway"
    },
    {
      "name": "luci-app-mcubridge",
      "makefilePath": "${workspaceFolder}/luci-app-mcubridge/Makefile",
      "makeDirectory": "${workspaceFolder}/luci-app-mcubridge"
    }
  ],
  "makefile.defaultConfiguration": "mcubridge",
  "makefile.makefilePath": "${workspaceFolder}/mcubridge/Makefile",
  "makefile.makeDirectory": "${workspaceFolder}/mcubridge",
  "makefile.configureOnOpen": true,
  "makefile.configureAfterCommand": false,
  "makefile.loggingLevel": "Normal",
  "makefile.dryrunSwitches": [],
  "python.analysis.autoImportCompletions": true,
  "python.analysis.languageServerMode": "full",
  "python.analysis.exclude": [
    "**/_pyrefly_virtual__/**",
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**",
    "/__pyrefly_virtual__/**",
    "**/*_pb2.py",
    "**/*_pb2.pyi",
    "**/*_grpc.py",
    ".tox",
    ".venv"
  ],
  "python.analysis.ignore": [
    "**/_pyrefly_virtual__/**",
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**",
    "/__pyrefly_virtual__/**"
  ],
  "pyrefly.analysis.exclude": [
    "**/_pyrefly_virtual__/**",
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**",
    "/__pyrefly_virtual__/**"
  ],
  "pyrefly.analysis.ignore": [
    "**/_pyrefly_virtual__/**",
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**",
    "/__pyrefly_virtual__/**"
  ],
  "files.exclude": {
    "**/_pyrefly_virtual__/**": true,
    "**/__pyrefly_virtual__/**": true,
    "**/inmemory/**": true
  },
  "files.watcherExclude": {
    "**/_pyrefly_virtual__/**": true,
    "**/__pyrefly_virtual__/**": true,
    "**/inmemory/**": true
  },
  "markdown.validate.enabled": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-action.json": ".github/actions/*/action.yml",
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  }
}
