module(
    name = "arduino_yun_bridge2",
    version = "2.8.9",
)

bazel_dep(name = "pigweed", version = "0.0.1")
bazel_dep(name = "avr_pigweed_port", version = "0.1.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "36.2", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_foreign_cc", version = "0.17.0")
bazel_dep(name = "rules_oci", version = "2.3.5")
bazel_dep(name = "rules_pkg", version = "1.3.0")

git_override(
    module_name = "nanopb",
    remote = "https://github.com/nanopb/nanopb.git",
    commit = "93550bb52a6216a7396d0a168a42b3a88223d811",
)

# Pigweed disables host toolchain autodetection; register its hermetic Linux host compiler.
register_toolchains("@pigweed//pw_toolchain/host_clang:host_cc_toolchain_linux")

local_path_override(
    module_name = "pigweed",
    path = "third_party/pigweed",
)

local_path_override(
    module_name = "avr_pigweed_port",
    path = "third_party/avr_pigweed_port",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

# Pinned full wolfSSL source archive shared by CMake and Bazel Gateway builds.
http_archive(
    name = "wolfssl_source",
    build_file_content = """
filegroup(
    name = "all_srcs",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "c9ac97ef8bd1888d66460a2bf7bb941d4511d4cc0b964e9e2b4bdce9934696a1",
    strip_prefix = "wolfssl-5.9.4",
    urls = ["https://downloads.sourceforge.net/project/wolfssl/v5.9.4-stable/wolfSSL%20Release%205.9.4%20%28September%2025%2C%202026%29%20source%20code.zip"],
)

pw_transfer_cooperative_repo = use_repo_rule("//tools/bazel:pw_transfer_cooperative.bzl", "pw_transfer_cooperative_repo")

new_local_repository(
    name = "avr_pigweed_legacy",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "pw_assert_avr",
    srcs = ["pw_assert_avr/src/assert_avr.cpp"],
    hdrs = glob(["pw_assert_avr/public/**/*.h"]),
    includes = ["pw_assert_avr/public"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "pw_log_avr",
    srcs = ["pw_log_avr/src/log_avr.cpp"],
    hdrs = glob(["pw_log_avr/public/**/*.h"]),
    includes = ["pw_log_avr/public"],
    visibility = ["//visibility:public"],
)

""",
    path = "third_party/avr_pigweed_port",
)

pw_transfer_cooperative_repo(
    name = "pw_transfer_cooperative",
    avr_patch = "@avr_pigweed_port//:patches/0001-avr-pw-transfer-and-protobuf.patch",
    pigweed_module = "@pigweed//:MODULE.bazel",
)

http_archive(
    name = "unity",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "unity",
    srcs = ["src/unity.c"],
    hdrs = glob(["src/*.h"]),
    includes = ["src"],
    defines = ["UNITY_INCLUDE_DOUBLE"],
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-6E6zAcp5Z4MeaLFyj5Eeh/otNF2N22T4l7wvLuJKMhw=",
    strip_prefix = "Unity-2.7.0",
    urls = ["https://github.com/ThrowTheSwitch/Unity/archive/refs/tags/v2.7.0.tar.gz"],
)

http_archive(
    name = "etl",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "etl",
    hdrs = glob(["include/**/*.h", "arduino/**/*.h"]),
    includes = ["include", "arduino"],
    defines = ["ETL_NO_STL", "ETL_FORCE_STD_INITIALIZER_LIST"],
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-s+elVEeV7I9KGyq0b26I/beL5aB3OPAIzhHdN+0UtuQ=",
    strip_prefix = "etl-20.49.0",
    urls = ["https://github.com/ETLCPP/etl/archive/refs/tags/20.49.0.tar.gz"],
)

http_archive(
    name = "wolfssl",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "wolfssl",
    srcs = [
        "src/wolfcrypt/src/sha256.c",
        "src/wolfcrypt/src/hmac.c",
        "src/wolfcrypt/src/kdf.c",
        "src/wolfcrypt/src/chacha.c",
        "src/wolfcrypt/src/poly1305.c",
        "src/wolfcrypt/src/chacha20_poly1305.c",
        "src/wolfcrypt/src/hash.c",
        "src/wolfcrypt/src/misc.c",
    ],
    hdrs = glob(["src/**/*.h"], exclude = ["src/user_settings.h"]),
    includes = ["src"],
    defines = ["WOLFSSL_USER_SETTINGS"],
    deps = ["@@//mcubridge-library-arduino:wolfssl_user_settings"],
    visibility = ["//visibility:public"],
)
""",
    patch_cmds = ["rm -f src/user_settings.h"],
    sha256 = "a3199eb282afdff6ed7ee438a175842a8c425a4264022019153e430def20ef96",
    strip_prefix = "wolfssl-5.8.4",
    urls = ["https://downloads.arduino.cc/libraries/github.com/wolfSSL/wolfssl-5.8.4.zip"],
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "debian_bookworm_slim",
    image = "index.docker.io/library/debian",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    tag = "bookworm-slim",
)
use_repo(
    oci,
    "debian_bookworm_slim",
    "debian_bookworm_slim_linux_amd64",
    "debian_bookworm_slim_linux_arm64",
)
