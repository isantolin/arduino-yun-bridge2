{
  "pw": {
    "pw_emu": {
      "emulators": {
        "qemu": {
          "connector": "pw_emu.qemu.QemuConnector",
          "launcher": "pw_emu.qemu.QemuLauncher"
        },
        "renode": {
          "connector": "pw_emu.renode.RenodeConnector",
          "launcher": "pw_emu.renode.RenodeLauncher"
        },
        "simavr": {
          "connector": "pw_emu_avr.simavr.SimavrConnector",
          "launcher": "pw_emu_avr.simavr.SimavrLauncher"
        }
      },
      "qemu": {
        "executable": "qemu-system-xtensa"
      },
      "renode": {
        "executable": "renode",
        "channels": {
          "terminals": {
            "type": "pty"
          }
        }
      },
      "simavr": {
        "executable": "../../build/simavr/simavr_pty_runner",
        "channels": {
          "type": "pty",
          "gdb": {
            "enabled": false
          }
        }
      },
      "target_files": [
        "../../third_party/avr_pigweed_port/tools/pw_emu_avr/targets.json"
      ],
      "targets": {
        "mkrwifi1010": {
          "gdb": [
            "arm-none-eabi-gdb"
          ],
          "renode": {
            "machine": "tools/emulation/renode/mkrwifi1010.repl",
            "channels": {
              "terminals": {
                "uart0": {
                  "device-path": "sysbus.uart0",
                  "type": "pty"
                }
              }
            }
          }
        },
        "esp32s3": {
          "qemu": {
            "machine": "esp32s3",
            "channels": {
              "chardevs": {
                "uart0": {
                  "id": "serial0",
                  "type": "pty"
                }
              }
            }
          }
        }
      }
    }
  }
}
