{
	"luci-app-mcubridge": {
		"description": "Grant access to McuBridge LuCI app",
		"read": {
			"uci": [ "mcubridge" ],
			"file": {
				"/tmp/mcubridge_status.json": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ],
				"mcubridge": [ "status", "process_poll", "datastore_get", "mailbox_read" ]
			}
		},
		"write": {
			"uci": [ "mcubridge" ],
			"file": {
				"/tmp/mcubridge-luci.*": [ "write" ]
			},
			"ubus": {
				"mcubridge": [ "digital_write", "analog_write", "mailbox_push", "datastore_set", "file_write", "process_run", "process_kill" ]
			},
			"file-exec": {
				"/usr/bin/mcubridge-rotate-credentials": [ "exec" ],
				"/usr/bin/mcubridge-hw-smoke": [ "exec" ],
				"/usr/bin/mcubridge-led-control": [ "exec" ],
				"/etc/init.d/mcubridge": [ "exec" ]
			}
		}
	}
}
