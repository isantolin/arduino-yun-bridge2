def get_auth_field(topic: str, action: str) -> str | None:
    norm_topic = lookup_topic(topic)
    top_name = norm_topic.name if norm_topic is not None else topic.upper()
    act_name = action.upper()
    top_val = norm_topic.value if norm_topic is not None else topic.lower()
    act_val = action.lower()
    return (
        TOPIC_AUTH_MAP.get((topic, action))
        or TOPIC_AUTH_MAP.get((top_name, act_name))
        or TOPIC_AUTH_MAP.get((top_val, act_val))
        or TOPIC_AUTH_MAP.get((topic.lower(), action.lower()))
        or TOPIC_AUTH_MAP.get((topic.upper(), action.upper()))
    )


def allows_method(auth: Any, spec: OperationSpec) -> bool:
    """Verify whether authorization config permits executing this RPC operation."""
    if getattr(auth, "allow_all", False):
        return True
    if spec.auth_field and getattr(auth, spec.auth_field, False):
        return True
    return False


def get_operation(key: Any) -> OperationSpec | None:
    """Polymorphic O(1) operation lookup. [SIL-2]"""
    if isinstance(key, tuple):
        return BY_RPC.get(cast(tuple[int, int], key))
    if isinstance(key, int):
        return BY_COMMAND_ID.get(key)
    if isinstance(key, str):
        return BY_NAME.get(key)
    if isinstance(key, type):
        return BY_TYPE.get(key)
    if isinstance(key, ProtobufMessage):
        return BY_TYPE.get(type(key)) or BY_NAME.get(key.DESCRIPTOR.name)
    if hasattr(key, "service_id") and hasattr(key, "method_id"):
        srv = getattr(key, "service_id", None)
        meth = getattr(key, "method_id", None)
        if isinstance(srv, int) and isinstance(meth, int):
            return BY_RPC.get((srv, meth))
    if hasattr(key, "value"):
        val = getattr(key, "value", None)
        if isinstance(val, int):
            return BY_COMMAND_ID.get(val)
    return None


def topic_path(prefix: str, topic: str | Topic, *segments: str | int) -> str:
    """[SIL-2] Construct topic path using direct join/filter delegation."""
    parts = [clean for s in (prefix, topic, *segments) if (clean := str(s).strip("/"))]
    return posixpath.join(*parts) if parts else ""


def get_topic_for_message(
    prefix: str, message: ProtobufMessage | type[ProtobufMessage] | int | str
) -> str | None:
    """Resolve canonical CLOUD topic for a given message, class, command ID or enum name. [SIL-2]"""
    spec = get_operation(message)
    if spec and spec.cloud_topic:
        return topic_path(prefix, *spec.cloud_topic.split("/"))
    return None


def parse_topic(prefix: str, topic_name: str) -> TopicRoute | None:
    """Parse incoming CLOUD topic into TopicRoute via compiled parse templates. [SIL-2]"""
    topic_norm = "/".join(p for p in topic_name.split("/") if p)
    if not topic_norm:
        return None

    # 1. Canonical Fleet Topic: devices/{device_id}/{direction}/{method}
    if (fleet := _FLEET_TOPIC_PARSER.parse(topic_norm)) is not None:
        dev_id = str(fleet["device_id"])
        direction = str(fleet["direction"]).lower()
        if "/" not in dev_id and direction in ("req", "res", "evt"):
            return TopicRoute(
                raw=topic_name,
                prefix=f"devices/{dev_id}",
                device_id=dev_id,
                direction=direction,
                method=str(fleet["method"]),
            )
        return None

    prefix_norm = "/".join(p for p in prefix.split("/") if p)
    if not prefix_norm or not topic_norm.startswith(f"{prefix_norm}/"):
        return None

    # 2. Canonical Direction Topic: {prefix}/{req|res|evt}/{method...}
    rel_topic = topic_norm.removeprefix(f"{prefix_norm}/")
    if (routed := _DIRECTION_TOPIC_PARSER.parse(rel_topic)) is not None:
        direction = str(routed["direction"]).lower()
        if direction in ("req", "res", "evt"):
            return TopicRoute(
                raw=topic_name,
                prefix=prefix_norm,
                device_id="",
                direction=direction,
                method=str(routed["method"]),
            )
    return None


