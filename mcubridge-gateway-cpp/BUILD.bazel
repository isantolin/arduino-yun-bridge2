load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_foreign_cc//foreign_cc:configure.bzl", "configure_make")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# Build a hermetic static OpenSSL matching Pigweed's C/C++ sysroot. The host
# runner's libssl.so is intentionally not imported: it is built against a
# newer glibc and cannot be linked safely with Pigweed's pinned sysroot.
configure_make(
    name = "openssl_static",
    configure_command = "config",
    configure_in_place = True,
    configure_options = [
        "no-shared",
        "no-tests",
        "no-apps",
        "no-docs",
        "--libdir=lib",
    ],
    # OpenSSL's upstream C sources intentionally trigger two strict-warning
    # diagnostics under Pigweed's hermetic Clang flags. Keep warnings visible,
    # but do not promote those specific OpenSSL warnings to build failures.
    env = {
        "CFLAGS": "-Wno-error=cast-qual -Wno-error=unused-parameter",
    },
    lib_source = "@openssl_source//:all_srcs",
    out_include_dir = "include",
    out_static_libs = [
        "libssl.a",
        "libcrypto.a",
    ],
    targets = [
        "build_libs",
        "install_dev",
    ],
)

cc_binary(
    name = "mcubridge-gateway-cpp",
    srcs = ["src/gateway_main.cc"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        # Pigweed's PW_METRIC macro uses __COUNTER__. Clang diagnoses that
        # compiler builtin as a C2y extension in this C++20 translation unit;
        # keep the diagnostic visible without turning it into a build failure.
        "-Wno-error=counter-extension",
    ],
    defines = [
        "PW_RPC_ENCODING_BUFFER_SIZE_BYTES=2048",
    ],
    linkopts = ["-lpthread", "-ldl"],
    deps = [
        "//tools/protocol:gateway_control_pwpb_rpc",
        "//tools/protocol:mcu_wire_raw_rpc",
        ":openssl_static",
        "@pigweed//pw_assert:backend_impl",
        "@pigweed//pw_assert:check",
        "@pigweed//pw_bytes",
        "@pigweed//pw_chrono:system_clock",
        "@pigweed//pw_chrono:system_timer",
        "@pigweed//pw_hdlc",
        "@pigweed//pw_hdlc:rpc_channel_output",
        "@pigweed//pw_log",
        "@pigweed//pw_log:backend_impl",
        "@pigweed//pw_log_basic",
        "@pigweed//pw_metric:metric",
        "@pigweed//pw_metric:metric_service_pwpb",
        "@pigweed//pw_protobuf",
        "@pigweed//pw_result",
        "@pigweed//pw_rpc",
        "@pigweed//pw_rpc/pwpb:client_api",
        "@pigweed//pw_rpc/pwpb:server_api",
        "@pigweed//pw_rpc/raw:client_api",
        "@pigweed//pw_status",
        "@pigweed//pw_stream",
        "@pigweed//pw_sync:binary_semaphore",
        "@pigweed//pw_sync:lock_annotations",
        "@pigweed//pw_sync:mutex",
        "@pigweed//pw_sync:scoped_locker",
        "@pigweed//pw_sync:timed_thread_notification",
        "@pigweed//pw_thread:thread",
        "@pigweed//pw_thread_stl:thread",
        "@pigweed//pw_transfer",
    ],
)

pkg_tar(
    name = "gateway_layer",
    srcs = [":mcubridge-gateway-cpp"],
    package_dir = "/usr/local/bin",
)

oci_image(
    name = "mcubridge-gateway-image",
    base = "@debian_bookworm_slim",
    cmd = [
        "--cert",
        "/etc/mcubridge-gateway/gateway.crt",
        "--key",
        "/etc/mcubridge-gateway/gateway.key",
        "--client-ca",
        "/etc/mcubridge-gateway/clients-ca.crt",
        "--acl",
        "/etc/mcubridge-gateway/gateway.acl",
        "--staging-dir",
        "/var/lib/mcubridge-gateway",
        "--bind",
        "*",
        "--port",
        "8443",
    ],
    entrypoint = ["/usr/local/bin/mcubridge-gateway-cpp"],
    env = {"MCUBRIDGE_GATEWAY_PORT": "8443"},
    exposed_ports = ["8443/tcp"],
    tars = [":gateway_layer"],
    workdir = "/var/lib/mcubridge-gateway",
)
