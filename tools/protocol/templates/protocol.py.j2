    {{ f.name|tojson }}: {% if f.field_type == 'bytes' %}b{{ f.raw_default|tojson }}{% elif f.field_type == 'str' %}{{ f.default_value|tojson }}{% elif f.field_type == 'bool' %}{{ f.default_value }}{% elif f.field_type == 'float' %}{{ f.default_value }}{% elif f.field_type == 'int' %}{{ f.default_value }}{% elif f.field_type == 'list' %}[]{% endif %},
{%- endif %}
{%- endfor %}
}

RUNTIME_CONFIG_METADATA: Final[dict[str, dict[str, Any]]] = {
{%- for f in runtime_config_fields %}
    {{ f.name|tojson }}: {
        "type": {{ f.field_type|tojson }},
        "description": (
            {{ f.description|tojson }}
        ),
        "volatile": {{ f.is_volatile }},
        "min": {{ f.min_val if f.min_val is not none else 'None' }},
        "max": {{ f.max_val if f.max_val is not none else 'None' }},
        "uci_option": {{ f.uci_option|tojson if f.uci_option else 'None' }},
    },
{%- endfor %}
}

# Canonical Configuration Defaults Constants [Rule 15]
{%- for const in runtime_config_constants %}
{{ const.name }}: Final[{{ const.type }}] = {{ const.value }}
{%- endfor %}

# ==============================================================================
# Pigweed HDLC Serialization Helpers
# ==============================================================================

def encode_rpc_packet(
    channel_id_or_command: int | OperationSpec | tuple[int, int],
    payload_or_service: Any = b"",
    method_id: int | None = None,
    call_id: int = 1,
    payload: Any = b"",
    packet_type: int = 0,
    status: int = 0,
) -> bytes:
    """Serialize a Pigweed RpcPacket without applying HDLC framing.

    Supports two calling conventions:
    1. Direct RPC: encode_rpc_packet(channel_id, service_id, method_id, call_id, payload=b"", packet_type=0, status=0)
    2. Operation/Command: encode_rpc_packet(command_or_op, payload=b"", call_id=1)
    """
    from google.protobuf.message import Message as ProtobufMessage
    from pw_rpc.internal.packet_pb2 import RpcPacket

    if method_id is None:
        target = channel_id_or_command
        spec = get_operation(target)
        actual_type = packet_type
        if spec is not None and spec.paired_request_id is not None:
            paired = get_operation(spec.paired_request_id)
            if paired is not None:
                spec = paired
                if actual_type == 0:
                    actual_type = 1
        if spec is not None and spec.service_id is not None and spec.method_id is not None:
            srv_id = spec.service_id
            meth_id = spec.method_id
        elif isinstance(target, tuple):
            srv_id, meth_id = target
        else:
            val = target if isinstance(target, int) else 0
            srv_id = val
            meth_id = val
        raw_payload = payload_or_service
        actual_call_id = call_id
        actual_payload = (
            raw_payload.SerializeToString()
            if isinstance(raw_payload, ProtobufMessage)
            else (raw_payload if isinstance(raw_payload, bytes) else b"")
        )
        pkt = RpcPacket(
            type=cast(Any, actual_type),
            channel_id=1,
            service_id=srv_id,
            method_id=meth_id,
            call_id=actual_call_id,
            status=status,
            payload=actual_payload,
        )
    else:
        channel_id = int(channel_id_or_command) if isinstance(channel_id_or_command, int) else 1
        srv_id = int(payload_or_service)
        meth_id = method_id
        actual_payload = (
            payload.SerializeToString()
            if isinstance(payload, ProtobufMessage)
            else (payload if isinstance(payload, bytes) else b"")
        )
        pkt = RpcPacket(
            type=cast(Any, packet_type),
            channel_id=channel_id,
            service_id=srv_id,
            method_id=meth_id,
            call_id=call_id,
            status=status,
            payload=actual_payload,
        )

    return pkt.SerializeToString()


def encode_hdlc_rpc(
    channel_id_or_command: int | OperationSpec | tuple[int, int],
    payload_or_service: Any = b"",
    method_id: int | None = None,
    call_id: int = 1,
    payload: Any = b"",
    packet_type: int = 0,
    status: int = 0,
) -> bytes:
    """Build and encode a Pigweed HDLC UI frame carrying an RpcPacket."""
    from pw_hdlc.encode import ui_frame

    packet = encode_rpc_packet(
        channel_id_or_command,
        payload_or_service,
        method_id,
        call_id,
        payload,
        packet_type,
        status,
    )
    return ui_frame(HDLC_ADDRESS_RPC, packet)


def encode_hdlc_console(data: bytes) -> bytes:
    """Encode raw console stream bytes into a Pigweed HDLC UI frame on HDLC_ADDRESS_CONSOLE."""
    from pw_hdlc.encode import ui_frame

    return ui_frame(HDLC_ADDRESS_CONSOLE, data)
