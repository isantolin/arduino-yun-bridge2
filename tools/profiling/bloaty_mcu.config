# Google Pigweed Bloaty Configuration for Embedded MCU Targets
# [SIL-2 / Rule 37]
#
# Maps ELF sections to physical microcontroller memory regions (Flash vs RAM).

custom_data_source: {
  name: "memoryregions"
  base_data_source: "sections"
  rewrite: {
    pattern: "^\\.text.*"
    replacement: "Flash"
  }
  rewrite: {
    pattern: "^\\.rodata.*"
    replacement: "Flash"
  }
  rewrite: {
    pattern: "^\\.vectors.*"
    replacement: "Flash"
  }
  rewrite: {
    pattern: "^\\.data.*"
    replacement: "RAM"
  }
  rewrite: {
    pattern: "^\\.bss.*"
    replacement: "RAM"
  }
  rewrite: {
    pattern: "^\\.noinit.*"
    replacement: "RAM"
  }
  rewrite: {
    pattern: ".*"
    replacement: "Other"
  }
}
