{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestPath": "./.venv/bin/pytest",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "."
  ],
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/mcubridge-library-arduino/src",
    "${workspaceFolder}/mcubridge-library-arduino/tests",
    "${workspaceFolder}/tools/arduino_stub/include",
    "${workspaceFolder}/.dummy_libs/Embedded_Template_Library/include",
    "${workspaceFolder}/.dummy_libs/Embedded_Template_Library/arduino",
    "${workspaceFolder}/.dummy_libs/wolfSSL",
    "${workspaceFolder}/.dummy_libs/PacketSerial/src",
    "${workspaceFolder}/.dummy_libs/Unity/src",
    "~/Arduino/libraries/**"
  ],
  "C_Cpp.default.defines": [
    "ARDUINO=100",
    "BRIDGE_HOST_TEST=1",
    "WOLFSSL_USER_SETTINGS",
    "ETL_NO_STL",
    "BRIDGE_ENABLE_CONSOLE=1",
    "BRIDGE_ENABLE_DATASTORE=1",
    "BRIDGE_ENABLE_MAILBOX=1",
    "BRIDGE_ENABLE_FILESYSTEM=1",
    "BRIDGE_ENABLE_PROCESS=1",
    "BRIDGE_ENABLE_SPI=1",
    "BRIDGE_ENABLE_TEST_INTERFACE=1",
    "BRIDGE_FAULT_INJECTION=1"
  ],
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "makefile.configureOnOpen": false,
  "makefile.configureAfterCommand": false,
  "makefile.loggingLevel": "Normal",
  "makefile.dryrunSwitches": [],
  "python.analysis.autoImportCompletions": true,
  "python.analysis.languageServerMode": "full",
  "markdown.validate.enabled": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-action.json": ".github/actions/*/action.yml",
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  }
}
