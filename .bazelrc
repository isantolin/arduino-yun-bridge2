common --enable_bzlmod
# Required upstream Pigweed Bzlmod flags (pigweed.dev/build/bazel/integration/setup.html).
common --incompatible_default_to_explicit_init_py
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --experimental_exclude_defines_from_exec_config
common --incompatible_exclude_starlark_flags_from_exec_config
build --incompatible_strict_action_env
common --legacy_external_runfiles=True
common --incompatible_bazel_test_exec_run_under=True
common --experimental_platform_in_output_dir=True
common --incompatible_enable_proto_toolchain_resolution
build --@com_google_protobuf//bazel/toolchains:prefer_prebuilt_protoc
build --extra_toolchains=@pigweed//pw_build:pw_python_proto_toolchain_toolchain
common --repo_env=DO_NOT_TRACK=1

build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20
build --per_file_copt=external/.*@-Wno-deprecated-declarations
# rules_cc_autoconf's build-time C++ helpers use exceptions throughout their
# checker and resolver implementations. Enable exceptions only for source files
# in that external build-tool repository; project, Pigweed, Gateway, and AVR
# targets retain the hermetic toolchain's -fno-exceptions default.
# These sources compile in Bazel's exec configuration ([for tool]), so use
# host_per_file_copt rather than per_file_copt (which targets the target config).
build --host_per_file_copt=external/.*rules_cc_autoconf.*/.*.cc@-fexceptions
# Host-side tools such as rules_foreign_cc's GNU make load modules with dlopen().
build --host_linkopt=-ldl
# Keep the upstream helper's unused-but-set-variable diagnostic visible,
# but do not let this third-party source warning stop the Gateway host build.
build --host_per_file_copt=external/.*rules_cc_autoconf.*/autoconf/private/checker/checker.cc@-Wno-error=unused-but-set-variable
# The adjacent checker source has a separate unused-variable diagnostic.
build --host_per_file_copt=external/.*rules_cc_autoconf.*/autoconf/private/checker/check.cc@-Wno-error=unused-variable
# The checker runner has two independent unused-variable diagnostics.
build --host_per_file_copt=external/.*rules_cc_autoconf.*/autoconf/private/checker/check_runner.cc@-Wno-error=unused-but-set-variable
build --host_per_file_copt=external/.*rules_cc_autoconf.*/autoconf/private/checker/check_runner.cc@-Wno-error=unused-variable
build --@pigweed//pw_log:backend=@pigweed//pw_log_basic
build --@pigweed//pw_sys_io:backend=@pigweed//pw_sys_io_stdio
build --@pigweed//pw_assert:assert_backend=@pigweed//pw_assert_basic
build --@pigweed//pw_assert:check_backend=@pigweed//pw_assert_basic
build --@pigweed//pw_assert:backend_impl=@pigweed//pw_assert_basic:impl

# Host cc_test suites use ArduinoStubs.cpp's simulated millis()-backed clock
# instead of pw_chrono_stl's inline GetSystemClockTickCount().
test --@pigweed//pw_chrono:system_clock_backend=//tools/pw_chrono_arduino:system_clock_host

coverage --combined_report=lcov
coverage --instrumentation_filter="^//mcubridge-gateway-cpp[/:],^//mcubridge-library-arduino[/:]"
