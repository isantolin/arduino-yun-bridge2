def build_mcu_dispatch(
    target: Any,
    *,
    status_handler: Callable[..., Any] | None = None,
) -> McuDispatchTable:
    """Build O(1) MCU dispatch table from Protocol SSOT. [SIL-2]"""
    status_fn = status_handler or getattr(target, "handle_mcu_status", None)
    dispatch: McuDispatchTable = {}
    if status_fn is not None:
        for s in Status:
            dispatch[s.value] = functools.partial(status_fn, s)
    for op in OPERATIONS:
        fn = operator.attrgetter(op.mcu_handler)(target) if op.mcu_handler else None
        if fn is not None:
            dispatch[op.name] = fn
            if op.service_id is not None and op.method_id is not None:
                dispatch[(op.service_id, op.method_id)] = fn
            if op.service_name and op.method_name:
                dispatch[f"{op.service_name}/{op.method_name}"] = fn
                dispatch[f"{op.service_name.removeprefix('rpc.pb.')}/{op.method_name}"] = fn
                dispatch.setdefault(op.method_name, fn)
    return dispatch


def build_ubus_methods(
    service: Any,
    ubus_backend: Any,
    *,
    handler_factory: Callable[[Callable[..., Any]], Callable[..., Any]] | None = None,
    get_type_fn: Callable[[str, Any], Any] | None = None,
    session_type: Any = None,
) -> dict[str, dict[str, Any]]:
    """Build OpenWrt UBUS method registration dictionary from Protocol SSOT. [SIL-2]"""
    def _default_get_type(typ: str, backend: Any) -> Any:
        if backend is None:
            return 0
        return getattr(backend, f"BLOBMSG_TYPE_{typ}", getattr(backend, typ, 0))

    def _identity_wrapper(fn: Callable[..., Any]) -> Callable[..., Any]:
        return fn

    type_resolver = get_type_fn or _default_get_type
    wrap: Callable[[Callable[..., Any]], Callable[..., Any]] = handler_factory or _identity_wrapper
    resolved_session_type = session_type if session_type is not None else type_resolver("STRING", ubus_backend)

    return {
        name: {
            "method": wrap(getattr(service, f"ubus_handle_{name}")),
            "signature": {
                **{arg: type_resolver(typ, ubus_backend) for arg, typ in args},
                "ubus_rpc_session": resolved_session_type,
            },
        }
        for name, args in UBUS_SIGNATURES
    }


def build_supervised_tasks(
    service: Any,
    *,
    fatal_exception_map: dict[str, type[BaseException]] | None = None,
) -> list[tuple[str, Callable[[], Any], tuple[type[BaseException], ...]]]:
    """Build supervised daemon tasks list from Protocol SSOT. [SIL-2]"""
    fatals_map = fatal_exception_map or {}
    tasks: list[tuple[str, Callable[[], Any], tuple[type[BaseException], ...]]] = []
    for task in DAEMON_TASKS:
        if task.condition_property and not operator.attrgetter(task.condition_property)(service):
            continue
        worker: Callable[[], Any] = operator.attrgetter(task.handler)(service)
        fatals: tuple[type[BaseException], ...] = (
            (fatals_map[task.fatal_exception],)
            if task.fatal_exception and task.fatal_exception in fatals_map
            else ()
        )
        tasks.append((task.name, worker, fatals))
    return tasks


